{
  "name": "@alb233/dsh-error-monitor",
  "version": "1.3.0",
  "type": "module",
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "description": "Lists this session's failures as copyable cards in the conversation view, attributes each to a cause, and carries the next step: send back with session id, retry the same call, mark resolved.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "tools/*.mjs",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "errors",
    "monitor",
    "session"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alb233/dsh-error-monitor.git"
  },
  "homepage": "https://github.com/alb233/dsh-error-monitor#readme",
  "bugs": {
    "url": "https://github.com/alb233/dsh-error-monitor/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}
